{
  "description": "Lines that make an HTML file a Luccet note, and lines that do not (docs/tools.html#detection). An editor tests each line of a file against pattern with flags, and the first line that matches is the luccet.js line: the head is what comes before the tag (group 1), and the note is every line after the line. Each match case gives the tag that group 1 must capture. pattern is the source of DETECT in cli/note.js; test/cli.js checks that they are the same and that every case holds.",
  "pattern": "^(?:[^<]|<(?!!--)|<!--(?:[^-]|-(?!->))*-->)*?(<script(?=[\\s>/])(?![^<>]*\\s(?:async|defer|data-built)(?=[\\s=>/]|$))(?![^<>]*\\stype\\s*=\\s*[\"']?module(?=[\"'\\s>/]|$))[^<>]*?\\ssrc\\s*=\\s*([\"']?)(?:[^\"'\\s<>]*\\/)?luccet\\.js(?:[?#][^\"'\\s<>]*)?\\2(?=[\\s>/])[^<>]*>)",
  "flags": "i",
  "tagGroup": 1,
  "match": [
    {
      "why": "the canonical first line",
      "line": "<!doctype html><meta charset=\"utf-8\"><script src=\"luccet.js\"></script>",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "the canonical first line with add-ons",
      "line": "<!doctype html><meta charset=\"utf-8\"><script src=\"luccet.js\" data-use=\"theorems.js theme.css\"></script>",
      "tag": "<script src=\"luccet.js\" data-use=\"theorems.js theme.css\">"
    },
    {
      "why": "the line luccet new writes: the tag, then the guard",
      "line": "<!doctype html><meta charset=\"utf-8\"><script src=\"luccet.js\"></script><noscript><p>JavaScript is off; the source follows.</p><xmp hidden></noscript><script>self.luccet||document.write('<p>luccet.js did not load; the source follows.</p><xmp hidden>')</script></xmp><plaintext style=\"white-space:pre-wrap\">",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "the line luccet new --lang=fr writes: the guard in French, marked lang=fr, with a typographic apostrophe",
      "line": "<!doctype html><meta charset=\"utf-8\"><script src=\"luccet.js\"></script><noscript><p lang=\"fr\">JavaScript est désactivé ; voici la source.</p><xmp hidden></noscript><script>self.luccet||document.write('<p lang=\"fr\">luccet.js n’a pas été chargé ; voici la source.</p><xmp hidden>')</script></xmp><plaintext lang=\"fr\" style=\"white-space:pre-wrap\">",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "a relative path",
      "line": "<script src=\"../../luccet.js\"></script>",
      "tag": "<script src=\"../../luccet.js\">"
    },
    {
      "why": "a root-relative path",
      "line": "<script src=\"/luccet.js\"></script>",
      "tag": "<script src=\"/luccet.js\">"
    },
    {
      "why": "a URL on a CDN",
      "line": "<script src=\"https://cdn.jsdelivr.net/gh/Luccet/luccet@1/luccet.js\"></script>",
      "tag": "<script src=\"https://cdn.jsdelivr.net/gh/Luccet/luccet@1/luccet.js\">"
    },
    {
      "why": "single quotes",
      "line": "<script src='luccet.js'></script>",
      "tag": "<script src='luccet.js'>"
    },
    {
      "why": "no quotes",
      "line": "<script src=luccet.js></script>",
      "tag": "<script src=luccet.js>"
    },
    {
      "why": "spaces around =",
      "line": "<script src = \"luccet.js\"></script>",
      "tag": "<script src = \"luccet.js\">"
    },
    {
      "why": "a query string",
      "line": "<script src=\"luccet.js?v=2\"></script>",
      "tag": "<script src=\"luccet.js?v=2\">"
    },
    {
      "why": "a fragment",
      "line": "<script src=\"lib/luccet.js#x\"></script>",
      "tag": "<script src=\"lib/luccet.js#x\">"
    },
    {
      "why": "attributes before and after src",
      "line": "<script nonce=\"r4nd0m\" src=\"luccet.js\" data-katex=\"none\"></script>",
      "tag": "<script nonce=\"r4nd0m\" src=\"luccet.js\" data-katex=\"none\">"
    },
    {
      "why": "a classic script type",
      "line": "<script type=\"text/javascript\" src=\"luccet.js\"></script>",
      "tag": "<script type=\"text/javascript\" src=\"luccet.js\">"
    },
    {
      "why": "upper case tag and attribute",
      "line": "<SCRIPT SRC=\"luccet.js\"></SCRIPT>",
      "tag": "<SCRIPT SRC=\"luccet.js\">"
    },
    {
      "why": "upper case file name (detection is case-insensitive throughout)",
      "line": "<script src=\"LUCCET.JS\"></script>",
      "tag": "<script src=\"LUCCET.JS\">"
    },
    {
      "why": "the tag in the middle of the line, after head elements",
      "line": "<html lang=\"de\"><title>Notizen</title><script src=\"luccet.js\"></script>",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "text after the tag on the same line",
      "line": "<script src=\"luccet.js\"></script> <!-- the note starts on the next line -->",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "a closed comment before the tag",
      "line": "<!-- my notes --><script src=\"luccet.js\"></script>",
      "tag": "<script src=\"luccet.js\">"
    },
    {
      "why": "a data-src before the real src",
      "line": "<script data-src=\"x.js\" src=\"luccet.js\"></script>",
      "tag": "<script data-src=\"x.js\" src=\"luccet.js\">"
    },
    {
      "why": "async and defer as words in other attributes",
      "line": "<script src=\"luccet.js\" data-use=\"async.js defer.css\" data-async=\"1\"></script>",
      "tag": "<script src=\"luccet.js\" data-use=\"async.js defer.css\" data-async=\"1\">"
    }
  ],
  "noMatch": [
    {
      "why": "a file named myluccet.js",
      "line": "<script src=\"myluccet.js\"></script>"
    },
    {
      "why": "a file named luccet.json",
      "line": "<script src=\"luccet.json\"></script>"
    },
    {
      "why": "a file named luccet.min.js (the file name is exactly luccet.js)",
      "line": "<script src=\"luccet.min.js\"></script>"
    },
    {
      "why": "luccet.js.map",
      "line": "<script src=\"luccet.js.map\"></script>"
    },
    {
      "why": "luccet-cli.js",
      "line": "<script src=\"luccet-cli.js\"></script>"
    },
    {
      "why": "a commented-out tag",
      "line": "<!-- <script src=\"luccet.js\"></script> -->"
    },
    {
      "why": "a tag inside a comment that the line does not close",
      "line": "<!-- <script src=\"luccet.js\"></script>"
    },
    {
      "why": "defer: luccet.js would not capture the note",
      "line": "<script defer src=\"luccet.js\"></script>"
    },
    {
      "why": "async: luccet.js would not capture the note",
      "line": "<script src=\"luccet.js\" async></script>"
    },
    {
      "why": "async with a value",
      "line": "<script src=\"luccet.js\" async=\"\"></script>"
    },
    {
      "why": "upper case DEFER",
      "line": "<script src=\"luccet.js\" DEFER></script>"
    },
    {
      "why": "a module script",
      "line": "<script type=\"module\" src=\"luccet.js\"></script>"
    },
    {
      "why": "a module script, unquoted",
      "line": "<script type=module src=\"luccet.js\"></script>"
    },
    {
      "why": "a page written by luccet build",
      "line": "<script data-built src=\"luccet.js\"></script>"
    },
    {
      "why": "a page written by luccet build, with formulas left",
      "line": "<script data-built=\"math\" src=\"luccet.js\" data-use=\"x.js\"></script>"
    },
    {
      "why": "data-src is not src",
      "line": "<script data-src=\"luccet.js\"></script>"
    },
    {
      "why": "not a script: a preload",
      "line": "<link rel=\"preload\" href=\"luccet.js\" as=\"script\">"
    },
    {
      "why": "not a script: an image",
      "line": "<img src=\"luccet.js\">"
    },
    {
      "why": "not a script: noscript",
      "line": "<noscript src=\"luccet.js\"></noscript>"
    },
    {
      "why": "not a script: scripts",
      "line": "<scripts src=\"luccet.js\"></scripts>"
    },
    {
      "why": "an escaped tag in text",
      "line": "&lt;script src=\"luccet.js\"&gt;&lt;/script&gt;"
    },
    {
      "why": "prose",
      "line": "Load luccet.js with a script tag."
    }
  ]
}
